SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./boaforma.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_SSL_MODE=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
TRUSTED_HOSTS=localhost,127.0.0.1
LOGIN_RATE_LIMIT=30
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_SECONDS=300
CHAT_RATE_LIMIT=60
CHAT_RATE_WINDOW_SECONDS=60
WORKOUT_RATE_LIMIT=30
WORKOUT_RATE_WINDOW_SECONDS=60
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.6
LLM_ENABLE_FALLBACK=true
GOOGLE_OAUTH_CLIENT_ID=
SOCIAL_DEFAULT_AGE=25
SOCIAL_DEFAULT_WEIGHT_KG=70
SOCIAL_DEFAULT_HEIGHT_CM=170
SOCIAL_DEFAULT_GOAL=saude
SOCIAL_DEFAULT_LEVEL=iniciante
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
